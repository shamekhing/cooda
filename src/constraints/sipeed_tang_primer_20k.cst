// ============================================================
// COODA physical constraints - Sipeed Tang Primer 20K
//
// Ports must match the synthesizable FPGA top (src/rtl/soc/fpga_top.sv):
//   clk27    -> 27 MHz oscillator
//   btn_n0   -> Dock key S1, active low (reset)
//   btn_n1   -> Dock key S2, active low (run)
//   led0..5  -> Dock LEDs LED0..LED5, ACTIVE LOW
//
// A constraint line naming a port that is absent from the top module
// aborts Place & Route with ERROR (CT1135), so every block below is
// either active and matching the RTL, or commented out with a reason.
//
// Syntax: "Gowin Design Physical Constraints User Guide" SUG935,
// appendix A.1 (IO_LOC) and A.2 (IO_PORT).
// ============================================================


// ============================================================
// DUAL-PURPOSE PINS - USED, SO THE PROJECT MUST ENABLE THEM
//
// led4 and led5 sit on two FPGA configuration pins:
//   C13 (LED0) = DONE
//   A13 (LED1) = READY
//
// Place & Route refuses to place a user signal on either unless the
// project's device configuration marks the function as regular I/O,
// and otherwise stops with
//   ERROR (PR2028) : the constrained location is useless in the package
//   ERROR (PR2017) : 'led4' cannot be placed according to constraint,
//                    for the location is a dedicated pin (DONE)
//
// That is a PROJECT SETTING, not a .cst constraint. impl/pnr/device.cfg
// must contain
//     set JTAG  regular_io = false
//     set SSPI  regular_io = false
//     set READY regular_io = true
//     set DONE  regular_io = true
//
// Two ways to get it:
//   * IDE : Project > Configuration > Dual-Purpose Pin, set DONE, READY
//           and (for the LCD build) SSPI to "regular I/O". The IDE keeps
//           this in memory and rewrites device.cfg from that copy on every
//           run, so editing impl/cooda_process_config.json on disk has no
//           effect while the project is open.
//   * CLI : gw_sh ... -use_done_as_gpio -use_ready_as_gpio
//           -use_sspi_as_gpio, or edit impl/pnr/device.cfg directly
//           (already done here: SSPI, DONE and READY are regular_io = true).
//
// IF YOU WOULD RATHER NOT DEPEND ON THIS: delete led4 and led5 from
// fpga_top.sv, comment out the two blocks below, and the build then
// needs no project configuration at all. That costs two of the six
// LEDs. It is the trade the previous revision of this project made.
//
// T10 (S0, the ~RST key) is SSPI SI/D2 and is NOT used, but the LCD build
// needs SSPI anyway: the Dock's RGB LCD data bit 2 (lcd_r[2]) is on N9,
// which is also an SSPI configuration pin. Without the release, PnR stops
// with
//   ERROR (PR2028) : the constrained location is useless in the package
//   ERROR (PR2017) : 'lcd_r[2]' cannot be placed according to constraint,
//                    for the location is a dedicated pin (SSPI)
//
// The HDMI build does not use N9, so it does not need SSPI. If another
// PR2017 appears for a different pin, the matching switch is one of
// MSPI / RECONFIG_N / JTAG / I2C (all false in device.cfg today).
// ============================================================


// ============================================================
// ACTIVE CONSTRAINTS
// ============================================================

// ---------------------------------------------------------------------------
// clk27 - 27 MHz oscillator on the core board (bank 0, 3.3 V, GCLKT_0)
// ---------------------------------------------------------------------------
IO_LOC  "clk27" H11;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---------------------------------------------------------------------------
// btn_n0, btn_n1 - Dock user keys S1/S2, active low (low = pressed)
//   btn_n0 = S1  T3   bank 4, 1.5 V   reset
//   btn_n1 = S2  T2   bank 4, 1.5 V   run
//
// The Dock fits pull-ups on the bank-4 keys, so PULL_MODE=UP matches
// the board and holds the keys de-asserted before configuration.
//
// S0 (T10) is SSPI SI/D2 and is not used. S3 (D7) and S4 (C7) are not
// used either: both sit in bank 6, whose VCCIO on this Dock is
// unconfirmed. The vendor factory test
// (TP20kExample/Lite-bottom_test_project) omits all three pins.
// ---------------------------------------------------------------------------
IO_LOC  "btn_n0" T3;
IO_PORT "btn_n0" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "btn_n1" T2;
IO_PORT "btn_n1" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// ---------------------------------------------------------------------------
// led0..led5 - Dock user LEDs LED0..LED5, ACTIVE LOW (low = lit)
//   led0 N16   led1 N14   led2 L14   led3 L16   bank 1, 3.3 V
//   led4 C13   led5 A13                         bank 3, 3.3 V   DONE / READY
//
// led4 and led5 are the DONE and READY configuration pins - see the note
// at the top of this file. The project must enable them as regular I/O.
//
// POLARITY: these pins LIGHT WHEN DRIVEN LOW, so the RTL must invert.
// Driving ledN = 1'b0 turns the LED ON. Check soc/fpga_top.sv: as
// currently written `assign led2 = 1'b0;` LIGHTS the LED rather than
// turning it off, and led0/led1 read inverted relative to their comments.
// ---------------------------------------------------------------------------
IO_LOC  "led0" N16;
IO_PORT "led0" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led1" N14;
IO_PORT "led1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led2" L14;
IO_PORT "led2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led3" L16;
IO_PORT "led3" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led4" C13;
IO_PORT "led4" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led5" A13;
IO_PORT "led5" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---------------------------------------------------------------------------
// sw[3:0] - Dock DIP switches SW2..SW5 - NOT PORTS OF THIS TOP
//
// The SoC top has no switch inputs. Kept for reference; the pins are
// bank 4 at 1.5 V if they are ever needed.
//   SW2 E9   SW3 E8   SW4 T4   SW5 T5
// (SW1 = B10 = RECONFIG_N: avoid, Sipeed's JTAG recovery depends on it.)
// ---------------------------------------------------------------------------
// IO_LOC  "sw[0]" E9;   IO_PORT "sw[0]" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
// IO_LOC  "sw[1]" E8;   IO_PORT "sw[1]" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
// IO_LOC  "sw[2]" T4;   IO_PORT "sw[2]" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
// IO_LOC  "sw[3]" T5;   IO_PORT "sw[3]" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;

// ---------------------------------------------------------------------------
// ---------------------------------------------------------------------------
// Dock HDMI output (TMDS) - TLVDS_OBUF pairs from fpga_top
//
// Pins: Sipeed Tang Primer 20K Dock pin table, same as the Sipeed HDMI
// example. One logical output per pair, mapped onto both pins of the
// dedicated pair.
//
//   tmds_clk_p      G16,H15     tmds_data_p[0] H14,H16 (blue)
//   tmds_data_p[1]  J15,K16     tmds_data_p[2] K14,K15 (red)
// TLVDS_OBUF infers the differential output type and drives the paired
// negative pad; constrain the positive port with both package pads as in
// the Sipeed HDMI reference design.
//
// These pins are only driven when fpga_top is built with
// VIDEO_HDMI = 1; the LCD build drives them to 0.
// ---------------------------------------------------------------------------
IO_LOC  "tmds_clk_p"      G16,H15;   IO_PORT "tmds_clk_p" PULL_MODE=NONE;
IO_LOC  "tmds_data_p[0]"  H14,H16;   IO_PORT "tmds_data_p[0]" PULL_MODE=NONE;
IO_LOC  "tmds_data_p[1]"  J15,K16;   IO_PORT "tmds_data_p[1]" PULL_MODE=NONE;
IO_LOC  "tmds_data_p[2]"  K14,K15;   IO_PORT "tmds_data_p[2]" PULL_MODE=NONE;
//
// The SoC has no video path and the Gowin DVI TX IP is not in the build.
// Pin map kept for reference:
// ---------------------------------------------------------------------------


// ============================================================
// DELIBERATELY UNUSED DOCK I/O
// ============================================================

// ---------------------------------------------------------------------------
// DIP switch 1 (SW1) - B10 - NOT USED
//
// The Dock wires SW1 to B10_IOR31B_~{RECFG}, the FPGA reconfiguration
// control pin. Sipeed's wiki depends on it: with SW1 in the enable
// position the core board is active, and toggling it is the documented
// way to recover a board whose dual-purpose pins have locked JTAG out.
// Using B10 as a user input requires
//     set RECONFIG_N regular_io = true
// which throws that recovery path away. The vendor factory test does not
// use B10 either.
// ---------------------------------------------------------------------------
// IO_LOC  "sw1" B10;
// IO_PORT "sw1" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// ---------------------------------------------------------------------------
// S0 (T10), LED0 (C13), LED1 (A13) - NOT USED
//
// Dual-purpose configuration pins: SSPI SI/D2, DONE and READY. See the
// note at the top of this file. Using them requires a project setting
// that the IDE will not read from disk while it is open.
// ---------------------------------------------------------------------------
// IO_LOC  "btn_n[0]" T10;
// IO_PORT "btn_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
// IO_LOC  "led_n[0]" C13;
// IO_PORT "led_n[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
// IO_LOC  "led_n[1]" A13;
// IO_PORT "led_n[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---------------------------------------------------------------------------
// Keys S3 (D7) and S4 (C7) - NOT USED
//
// Both sit in bank 6, whose device default VCCIO is 1.8 V while the
// Sipeed templates constrain them as LVCMOS15. That discrepancy was
// never resolved against the Dock schematic, and the vendor factory test
// omits both pins. Not used until the schematic is checked.
// ---------------------------------------------------------------------------
// IO_LOC  "btn_n[2]" D7;
// IO_PORT "btn_n[2]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// IO_LOC  "btn_n[3]" C7;
// IO_PORT "btn_n[3]" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;


// ---------------------------------------------------------------------------
// Onboard 1 Gbit DDR3 SDRAM (SSTL15) - memory_ddr3_phy
//
// Driven by the open-source slow DDR3 controller (memory_ddr3_phy), not
// the Gowin IP, so the port names are the RTL's ddr3_* pins.
//
// Every pin needs an explicit BANK_VCCIO=1.5: the DDR3 pins span banks
// 4, 5 and 6, whose device defaults are 1.5 / 1.8 / 1.8 V. The DQ/DQS
// groups must stay together and VREF=INTERNAL belongs on the DQ pins
// only.
//
// DIFFERENTIAL PAIRS: the controller has separate ck_p/ck_n and
// dqs_p/dqs_n ports, so the true differential pairs (ck J1/J3,
// dqs0 G2/G3, dqs1 J5/K6) are constrained here as two single-ended
// SSTL15 pins each. That is what the controller drives. If PnR objects
// to driving half of a dedicated pair, the alternative is the Gowin
// two-pin IO_LOC form (IO_TYPE=SSTL15D on one port) with the *_n port
// merged into it in the RTL.
//
// Pin data: Sipeed example, cross-checked against this device's PnR
// report.
// ---------------------------------------------------------------------------
IO_LOC  "ddr3_addr[0]" F7;   IO_PORT "ddr3_addr[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[1]" A4;   IO_PORT "ddr3_addr[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[2]" D6;   IO_PORT "ddr3_addr[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[3]" F8;   IO_PORT "ddr3_addr[3]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[4]" C4;   IO_PORT "ddr3_addr[4]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[5]" E6;   IO_PORT "ddr3_addr[5]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[6]" B1;   IO_PORT "ddr3_addr[6]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[7]" D8;   IO_PORT "ddr3_addr[7]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[8]" A5;   IO_PORT "ddr3_addr[8]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[9]" F9;   IO_PORT "ddr3_addr[9]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[10]" K3;  IO_PORT "ddr3_addr[10]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[11]" B7;  IO_PORT "ddr3_addr[11]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[12]" A3;  IO_PORT "ddr3_addr[12]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_addr[13]" C8;  IO_PORT "ddr3_addr[13]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_bank[0]" H4;   IO_PORT "ddr3_bank[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_bank[1]" D3;   IO_PORT "ddr3_bank[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_bank[2]" H5;   IO_PORT "ddr3_bank[2]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_ras" R4;       IO_PORT "ddr3_ras" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_cas" R6;       IO_PORT "ddr3_cas" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_we" L2;        IO_PORT "ddr3_we" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_cs" P5;        IO_PORT "ddr3_cs" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_cke" J2;       IO_PORT "ddr3_cke" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_odt" R3;       IO_PORT "ddr3_odt" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_rst_n" B9;     IO_PORT "ddr3_rst_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_dm[0]" G1;     IO_PORT "ddr3_dm[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_dm[1]" K5;     IO_PORT "ddr3_dm[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_ck_p" J1;      IO_PORT "ddr3_ck_p" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_ck_n" J3;      IO_PORT "ddr3_ck_n" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[0]"  G5;    IO_PORT "ddr3_dq[0]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[1]"  F5;    IO_PORT "ddr3_dq[1]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[2]"  F4;    IO_PORT "ddr3_dq[2]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[3]"  F3;    IO_PORT "ddr3_dq[3]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[4]"  E2;    IO_PORT "ddr3_dq[4]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[5]"  C1;    IO_PORT "ddr3_dq[5]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[6]"  E1;    IO_PORT "ddr3_dq[6]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[7]"  B3;    IO_PORT "ddr3_dq[7]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[8]"  M3;    IO_PORT "ddr3_dq[8]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[9]"  K4;    IO_PORT "ddr3_dq[9]"  IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[10]" N2;    IO_PORT "ddr3_dq[10]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[11]" L1;    IO_PORT "ddr3_dq[11]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[12]" P4;    IO_PORT "ddr3_dq[12]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[13]" H3;    IO_PORT "ddr3_dq[13]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[14]" R1;    IO_PORT "ddr3_dq[14]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dq[15]" M2;    IO_PORT "ddr3_dq[15]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dqs_p[0]" G2;  IO_PORT "ddr3_dqs_p[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dqs_n[0]" G3;  IO_PORT "ddr3_dqs_n[0]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dqs_p[1]" J5;  IO_PORT "ddr3_dqs_p[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;
IO_LOC  "ddr3_dqs_n[1]" K6;  IO_PORT "ddr3_dqs_n[1]" IO_TYPE=SSTL15 PULL_MODE=NONE DRIVE=8 VREF=INTERNAL BANK_VCCIO=1.5;

// ---------------------------------------------------------------------------
// Dock RGB LCD - video_lcd (parallel RGB565 + sync + backlight)
//
// Pins: Sipeed Tang Primer 20K Dock pin table. 3.3 V LVCMOS: IO_TYPE and
// BANK_VCCIO are both explicit, otherwise the tool infers LVCMOS18 for
// these pins and the bank's 3.3 V lock collides with it (ERROR CT1136).
// ---------------------------------------------------------------------------
IO_LOC  "lcd_dclk" R9;    IO_PORT "lcd_dclk" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_de"   E15;   IO_PORT "lcd_de" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_hs"   A15;   IO_PORT "lcd_hs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_vs"   D14;   IO_PORT "lcd_vs" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_bl"   E10;   IO_PORT "lcd_bl" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_r[0]" L9;    IO_PORT "lcd_r[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_r[1]" N8;    IO_PORT "lcd_r[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_r[2]" N9;    IO_PORT "lcd_r[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_r[3]" N7;    IO_PORT "lcd_r[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_r[4]" N6;    IO_PORT "lcd_r[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_g[0]" D11;   IO_PORT "lcd_g[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_g[1]" A11;   IO_PORT "lcd_g[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_g[2]" B11;   IO_PORT "lcd_g[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_g[3]" P7;    IO_PORT "lcd_g[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_g[4]" R7;    IO_PORT "lcd_g[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_g[5]" D10;   IO_PORT "lcd_g[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_b[0]" B12;   IO_PORT "lcd_b[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_b[1]" C12;   IO_PORT "lcd_b[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_b[2]" B13;   IO_PORT "lcd_b[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_b[3]" A14;   IO_PORT "lcd_b[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "lcd_b[4]" B14;   IO_PORT "lcd_b[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

