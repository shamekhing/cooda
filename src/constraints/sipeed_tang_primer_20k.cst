// Minimal CPU board pins: 27 MHz clock, reset/run buttons, status LEDs.
IO_LOC  "clk27" H11;
IO_PORT "clk27" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "btn_n0" T3;
IO_PORT "btn_n0" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "btn_n1" T2;
IO_PORT "btn_n1" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
// The viewer's rate buttons live on header pins; jumper each to
// ground for a press (the dock only carries the two tactile ones).
IO_LOC  "btn_n2" T12;
IO_PORT "btn_n2" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;
IO_LOC  "btn_n3" T11;
IO_PORT "btn_n3" IO_TYPE=LVCMOS15 PULL_MODE=UP BANK_VCCIO=1.5;

// HDMI TMDS: true LVDS output buffers drive each differential pair.
// Constrain the positive side; Gowin assigns the paired negative pin.
IO_LOC  "tmds_clk_p" G16,H15;
IO_PORT "tmds_clk_p" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
IO_LOC  "tmds_data_p[0]" H14,H16;
IO_PORT "tmds_data_p[0]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
IO_LOC  "tmds_data_p[1]" J15,K16;
IO_PORT "tmds_data_p[1]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
IO_LOC  "tmds_data_p[2]" K14,K15;
IO_PORT "tmds_data_p[2]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;
// Dock user LEDs (Orange_LED0..5), from the Sipeed Dock schematic:
// C13, A13, N16, N14, L14, L16.
IO_LOC  "led0" C13;
IO_PORT "led0" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led1" A13;
IO_PORT "led1" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led2" N16;
IO_PORT "led2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led3" N14;
IO_PORT "led3" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led4" L14;
IO_PORT "led4" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led5" L16;
IO_PORT "led5" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

