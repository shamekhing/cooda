// Keep the PLL in the location used by the calibrated upstream PHY.
// fpga_top wraps the SoC, so the path runs through its instance.
INS_LOC "u_soc/pll/rpll_inst" PLL_L[0];

// microSD card, SPI mode. These are the pins the dock's slot is wired
// to (the same mapping LiteX-Boards uses for this board), and they are
// the four an SPI-mode card needs out of the six the slot has: DAT1
// (M7) and DAT2 (M10) are wired but unused, and D15 is card detect.
// The whole path runs in the clk27 domain, at 397 kHz while the card
// wakes up and 13.5 MHz for data, so nothing here needs a new clock.
// The slot's pins straddle two banks: cs/sck/mosi (N11, N10, R14)
// share bank 2 with the DDR3, whose SSTL15 pins lock the rail at
// 1.5 V, while miso (M8) is in a 3.3 V bank. Each pin follows its
// own bank; the dock handles the level difference.
IO_LOC  "sd_cs_n" N11;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "sd_sck" N10;
IO_PORT "sd_sck" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "sd_mosi" R14;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "sd_miso" M8;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// The UART pins are in the 1.5 V bank shared with DDR3.
IO_LOC  "uart_tx_pin" M11;
IO_PORT "uart_tx_pin" IO_TYPE=LVCMOS15 PULL_MODE=UP DRIVE=8 BANK_VCCIO=1.5;
IO_LOC  "uart_rx_pin" T13;
IO_PORT "uart_rx_pin" IO_TYPE=LVCMOS15 PULL_MODE=NONE BANK_VCCIO=1.5;
